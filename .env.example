# Copie este arquivo para ".env" e preencha com os dados do seu cluster no MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=cp5_filmes

# URL onde a API (FastAPI) estará rodando — usada pelo dashboard
API_BASE_URL=http://localhost:8000
